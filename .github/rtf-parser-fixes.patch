+
+#[test]
+fn control_words_and_symbols_each_consume_one_unicode_fallback() {
+    for fallback in [r"\emdash ", r"\~", r"\@", r"\*", "\\\n", r"\bin2 xy", r"\b "] {
+        let rtf = format!(r"{{\rtf1\ansi\uc1\u8212{fallback}X}}");
+        let doc = rtf_parser_tt::RtfDocument::from_bytes(rtf.as_bytes()).unwrap();
+        assert_eq!(doc.get_text(), "\u{2014}X", "{fallback:?}");
+        assert!(!doc.body.last().unwrap().painter.bold);
+    }
+    let rtf = br"{\rtf1\ansi\uc3\u8212\'2d\~\b X{\uc2\u233?}Y}";
+    assert_eq!(rtf_parser_tt::RtfDocument::from_bytes(rtf).unwrap().get_text(), "\u{2014}X\u{e9}Y");
+}
+
+#[test]
+fn plain_restores_the_default_font_and_cpg_overrides_charset() {
+    let rtf = br"{\rtf1\ansi\ansicpg1252\deff1{\fonttbl{\f0\fcharset0 Latin;}{\f1\fcharset0\cpg1251 Cyrillic;}}\f0\'e9{\plain\'e9}\'e9\plain\'e9}";
+    assert_eq!(rtf_parser_tt::RtfDocument::from_bytes(rtf).unwrap().get_text(), "\u{e9}\u{439}\u{e9}\u{439}");
+}
+
+#[test]
+fn unknown_code_pages_use_the_ansi_default_for_raw_and_escaped_bytes() {
+    let rtf = b"{\\rtf1\\ansi\\ansicpg777 \x80\\'80}";
+    assert_eq!(rtf_parser_tt::RtfDocument::from_bytes(rtf).unwrap().get_text(), "\u{20ac}\u{20ac}");
+}
+
+#[cfg(feature = "encoding_rs")]
+#[test]
+fn legacy_code_pages_apply_to_raw_bytes_and_escapes_in_default_font() {
+    let koi8 = b"{\\rtf1\\ansi\\ansicpg20866{\\fonttbl{\\f0\\fcharset0 Default;}{\\f1\\fcharset204 Cyrillic;}}\\f0 \xc1\\'c1{\\f1\\'c1}\\'c1}";
+    let latin2 = b"{\\rtf1\\ansi\\ansicpg28592 \xa1\\'a1}";
+    assert_eq!(rtf_parser_tt::RtfDocument::from_bytes(koi8).unwrap().get_text(), "\u{430}\u{430}\u{411}\u{430}");
+    assert_eq!(rtf_parser_tt::RtfDocument::from_bytes(latin2).unwrap().get_text(), "\u{104}\u{104}");
+}
