@@ -160,3 +160,36 @@ fn errors_are_send_and_sync() {
     let boxed: Box<dyn std::error::Error + Send + Sync> = Box::new(RtfDocument::try_from(r"{\rtf1 \'zz}").unwrap_err());
     assert!(!boxed.to_string().is_empty());
